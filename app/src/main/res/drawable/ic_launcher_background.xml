<?xml version="1.0" encoding="utf-8"?>
<!--
  Uygulama ikonunun zemini. Kaynak görseldeki köşegen gradyan (sol üst mavi ->
  sağ alt mor) burada shape olarak yeniden kuruluyor: yoğunluk başına PNG
  üretmeye gerek kalmıyor ve her boyutta bantsız çıkıyor.
  angle=315 -> sol üstten sağ alta.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#1589FE"
        android:endColor="#AF53DF" />
</shape>
